    "月曜〜現在までの合計歩数を週の目標歩数(1日の目標歩数×7)で割った数値が表示されます" : {
      "comment" : "Weekly progress info popover description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays total steps from Monday to now, divided by the weekly step goal (daily goal × 7)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示从周一至今的累计步数除以每周目标步数（每日目标×7）的比例"
          }
        }
      }
    },
